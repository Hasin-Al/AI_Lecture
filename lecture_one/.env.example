# Choose one provider: gemini, groq, cerebras, cohere, cloudflare, nvidia, openrouter
AI_PROVIDER=gemini

# Set only the key for your selected provider. Never commit your real .env file.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Model IDs and endpoints can change. Check the official provider guide in README.md.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_MODEL=gpt-oss-120b
COHERE_MODEL=command-a-plus-05-2026
CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
OPENROUTER_MODEL=openrouter/free
